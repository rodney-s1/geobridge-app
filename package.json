{
  "name": "geobridge-app",
  "version": "1.0.4",
  "description": "GeoBridge Invoicing Suite - Geotab MyAdmin to QuickBooks Bridge",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\" \"wait-on http://localhost:5173 && electron .\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && ..\\.venv\\Scripts\\python.exe run_backend.py",
    "build:frontend": "cd frontend && npm run build",
    "build": "npm run build:frontend && electron-builder",
    "start": "electron .",
    "release": "node scripts/release.js"
  },
  "keywords": [],
  "author": "GeoBridge",
  "license": "UNLICENSED",
  "private": true,
  "devDependencies": {
    "concurrently": "^9.0.1",
    "electron": "^42.4.0",
    "electron-builder": "^25.1.8",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.geobridge.invoicing",
    "productName": "GeoBridge",
    "artifactName": "GeoBridge-Setup-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "frontend/dist/**/*",
      "backend/**/*",
      "assets/**/*",
      "node_modules/electron-updater/**/*",
      "node_modules/electron-log/**/*",
      "node_modules/builder-util-runtime/**/*"
    ],
    "extraResources": [
      {
        "from": ".venv",
        "to": ".venv",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "rodney-s1",
      "repo": "geobridge-app",
      "releaseType": "release",
      "private": true
    },
    "mac": {
      "category": "public.app-category.business",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GeoBridge",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    }
  },
  "dependencies": {
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9"
  }
}
