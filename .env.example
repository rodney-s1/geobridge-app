# Geotab MyAdmin API
MYADMIN_USERNAME=your_myadmin_email@company.com
MYADMIN_PASSWORD=your_myadmin_password
MYADMIN_API_URL=https://myadminapi.geotab.com/v2/MyAdminApi.ashx
MYADMIN_ACCOUNT_ID=your_account_id

# Intuit QuickBooks (fill in when ready)
QB_APP_TOKEN=your_qb_app_token

# GeoBridge Middleware (fill in when dev team deploys)
MIDDLEWARE_BASE_URL=https://your-middleware.yourcompany.com
MIDDLEWARE_API_KEY=your_middleware_api_key

# App Settings
APP_ENV=development
BACKEND_PORT=8000
